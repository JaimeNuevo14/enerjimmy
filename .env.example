# Cadena de conexión a Postgres. En local puede ser un Postgres instalado en
# tu máquina, o (más simple) una rama de desarrollo gratuita en Neon
# (neon.tech). En producción (Vercel) usa tu base de datos Neon/Vercel
# Postgres/Supabase real.
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/enerjimmy"

# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-generado"
NEXTAUTH_URL="http://localhost:3000"
