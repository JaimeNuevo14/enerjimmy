# Base de datos local (SQLite, un archivo). Para producción multi-usuario,
# cambia el provider en prisma/schema.prisma a "postgresql" y pon aquí la
# cadena de conexión de tu Postgres alojado (Neon, Supabase, Vercel Postgres).
DATABASE_URL="file:./prisma/dev.db"

# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-generado"
NEXTAUTH_URL="http://localhost:3000"
