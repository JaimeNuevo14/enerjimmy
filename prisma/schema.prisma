// Prisma schema for ENERJIMMY
// Uses PostgreSQL. Point DATABASE_URL at a local Postgres instance or a
// hosted one (Neon / Supabase / Vercel Postgres) — same schema either way.
// See README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String   @unique
  // Nullable so existing pre-password accounts keep working: null means
  // "no password set yet" and the next login adopts whatever is typed.
  passwordHash String?
  createdAt    DateTime @default(now())

  routines        Routine[]
  workoutLogs     WorkoutLog[]
  workoutSessions WorkoutSession[]
  customExercises Exercise[]       @relation("CustomExercises")
}

model Exercise {
  id              String   @id @default(cuid())
  name            String   @unique
  muscleGroup     String
  equipment       String
  category        String
  isCustom        Boolean  @default(false)
  createdByUserId String?
  createdBy       User?    @relation("CustomExercises", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  routineExercises RoutineExercise[]
  workoutLogs      WorkoutLog[]

  @@index([muscleGroup])
  @@index([equipment])
}

model Routine {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  days RoutineDay[]

  @@index([userId])
}

model RoutineDay {
  id        String @id @default(cuid())
  routineId String
  dayOfWeek String // lunes, martes, miercoles, jueves, viernes, sabado, domingo
  order     Int    @default(0)

  routine         Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises       RoutineExercise[]
  workoutSessions WorkoutSession[]

  @@index([routineId])
}

model RoutineExercise {
  id           String @id @default(cuid())
  routineDayId String
  exerciseId   String
  order        Int    @default(0)
  targetSets   Int    @default(3)
  targetReps   String @default("8-12")

  routineDay  RoutineDay   @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exercise    Exercise     @relation(fields: [exerciseId], references: [id])
  workoutLogs WorkoutLog[]

  @@index([routineDayId])
  @@index([exerciseId])
}

model WorkoutLog {
  id                String   @id @default(cuid())
  userId            String
  routineExerciseId String?
  exerciseId        String
  workoutSessionId  String?
  date              DateTime @default(now())
  setNumber         Int
  // Strength sets: weightKg + reps. Cardio entries leave these null and use
  // durationSeconds/distanceKm/speedKmh instead — a WorkoutLog row is
  // either a strength set or a cardio session entry, never both.
  weightKg          Float?
  reps              Int?
  durationSeconds   Int?
  distanceKm        Float?
  // Legacy pace field (min:sec/km) — kept for any cardio rows logged before
  // "velocidad media" replaced it, so they keep displaying correctly. New
  // cardio entries no longer ask for this; they populate speedKmh instead
  // (lib/actions.ts derives a paceSecPerKm from it for backward-compatible
  // reads, but nothing user-facing asks for pace anymore).
  paceSecPerKm      Int?
  // Speed in km/h, as read directly off the cardio machine's display. This
  // is what new cardio entries actually store going forward.
  speedKmh          Float?
  notes             String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineExercise RoutineExercise? @relation(fields: [routineExerciseId], references: [id], onDelete: SetNull)
  exercise        Exercise         @relation(fields: [exerciseId], references: [id])
  workoutSession  WorkoutSession?  @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([exerciseId])
  @@index([userId, exerciseId])
  @@index([workoutSessionId])
}

// A "Finalizar rutina" summary: groups the WorkoutLog rows logged in one
// sitting for a routine day and stores the computed highlights (total
// weight moved, sets, exercises, cardio distance) so /history can show a
// per-session card without recomputing from scratch each time.
model WorkoutSession {
  id                     String   @id @default(cuid())
  userId                 String
  routineDayId           String?
  date                   DateTime @default(now())
  totalWeightKg          Float    @default(0)
  totalSets              Int      @default(0)
  totalExercises         Int      @default(0)
  totalReps              Int?
  totalCardioDistanceKm  Float?
  createdAt              DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineDay  RoutineDay?  @relation(fields: [routineDayId], references: [id], onDelete: SetNull)
  workoutLogs WorkoutLog[]

  @@index([userId])
  @@index([routineDayId])
}
